{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of replicas"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Image pull policy"
        },
        "tag": {
          "type": "string",
          "description": "Container image tag"
        }
      },
      "required": ["repository", "pullPolicy"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Image pull secrets for private registries"
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full resource name"
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "external": {
          "type": "object",
          "properties": {
            "dsn": {
              "type": "string",
              "description": "Full PostgreSQL DSN"
            },
            "host": {
              "type": "string",
              "description": "PostgreSQL host"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "PostgreSQL port"
            },
            "database": {
              "type": "string",
              "description": "Database name"
            },
            "username": {
              "type": "string",
              "description": "Database username"
            },
            "password": {
              "type": "string",
              "description": "Database password"
            },
            "sslMode": {
              "type": "string",
              "enum": ["disable", "require", "verify-ca", "verify-full"],
              "description": "SSL mode"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "encryptionKey": {
          "type": "string",
          "description": "AES-256 encryption key (base64-encoded)"
        },
        "databasePassword": {
          "type": "string",
          "description": "Database password"
        },
        "existingSecret": {
          "type": "string",
          "description": "Use existing secret"
        },
        "keys": {
          "type": "object",
          "properties": {
            "encryptionKey": {
              "type": "string"
            },
            "databasePassword": {
              "type": "string"
            },
            "dsn": {
              "type": "string"
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "listenPg": {
          "type": "string",
          "description": "PostgreSQL proxy listen address"
        },
        "listenApi": {
          "type": "string",
          "description": "REST API listen address"
        },
        "baseUrl": {
          "type": "string",
          "description": "Base URL for frontend"
        },
        "runMode": {
          "type": "string",
          "enum": ["", "test", "demo"],
          "description": "Run mode"
        },
        "keyFile": {
          "type": "string",
          "description": "Path to encryption key file"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
              "description": "Service type"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Service port"
            },
            "portName": {
              "type": "string",
              "description": "Name of the API port on the service"
            },
            "includeProxyPort": {
              "type": "boolean",
              "description": "Also expose the proxy port on the API service"
            },
            "annotations": {
              "type": "object",
              "description": "Service annotations"
            }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable proxy service"
            },
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
              "description": "Service type"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Service port"
            },
            "nodePort": {
              "type": ["integer", "string"],
              "description": "Fixed NodePort"
            },
            "nameSuffix": {
              "type": "string",
              "description": "Suffix appended to the fullname for the proxy service"
            },
            "portName": {
              "type": "string",
              "description": "Name of the PostgreSQL proxy port"
            },
            "externalIPs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "External IPs bound to the proxy service"
            },
            "annotations": {
              "type": "object",
              "description": "Service annotations"
            }
          }
        },
        "oracle": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable Oracle proxy service"
            },
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
              "description": "Service type"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Service port"
            },
            "nodePort": {
              "type": ["integer", "string"],
              "description": "Fixed NodePort"
            },
            "annotations": {
              "type": "object",
              "description": "Service annotations"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable ingress"
        },
        "className": {
          "type": "string",
          "description": "Ingress class name"
        },
        "annotations": {
          "type": "object",
          "description": "Ingress annotations"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "extraIngresses": {
      "type": "array",
      "description": "Additional Ingress objects, each named <fullname>-<nameSuffix>",
      "items": {
        "type": "object",
        "required": ["nameSuffix"],
        "properties": {
          "nameSuffix": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "annotations": {
            "type": "object"
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string"
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "pathType": {
                        "type": "string",
                        "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                      }
                    }
                  }
                }
              }
            }
          },
          "tls": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "redirectHttpsMiddleware": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render the HTTP->HTTPS Middleware CRD"
            },
            "name": {
              "type": "string",
              "description": "Middleware object name"
            },
            "permanent": {
              "type": "boolean",
              "description": "Emit 301 rather than 302"
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable HTTPRoute (Gateway API)"
        },
        "annotations": {
          "type": "object",
          "description": "HTTPRoute annotations"
        },
        "hostnames": {
          "type": "array",
          "description": "Hostnames the route matches",
          "items": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array",
          "description": "Parent Gateway references",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              }
            }
          }
        },
        "paths": {
          "type": "array",
          "description": "Matched path prefixes",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create service account"
        },
        "annotations": {
          "type": "object",
          "description": "Service account annotations"
        },
        "name": {
          "type": "string",
          "description": "Service account name"
        },
        "automountServiceAccountToken": {
          "type": "boolean",
          "description": "Automount service account token"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "description": "Pod annotations"
    },
    "podLabels": {
      "type": "object",
      "description": "Pod labels"
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Pod security context"
    },
    "securityContext": {
      "type": "object",
      "description": "Container security context"
    },
    "resources": {
      "type": "object",
      "description": "Resource limits and requests"
    },
    "goMemLimit": {
      "type": "string",
      "description": "Soft memory ceiling for the Go runtime (GOMEMLIMIT); empty disables it"
    },
    "livenessProbe": {
      "type": "object",
      "description": "Liveness probe configuration"
    },
    "readinessProbe": {
      "type": "object",
      "description": "Readiness probe configuration"
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": ["integer", "string"]
        },
        "maxUnavailable": {
          "type": ["integer", "string"]
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "description": "Node selector"
    },
    "tolerations": {
      "type": "array",
      "description": "Tolerations"
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules"
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedPodLabels": {
          "type": "object"
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "description": "Additional environment variables"
    },
    "extraVolumeMounts": {
      "type": "array",
      "description": "Additional volume mounts"
    },
    "extraVolumes": {
      "type": "array",
      "description": "Additional volumes"
    }
  }
}
